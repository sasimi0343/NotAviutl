@[Utility] Nothing

obj.alpha = 0
obj.zoom = 0

return

@[Utility] MakeGroup
--track0:ID,0,1000,0,1
local id = tostring(obj.track0)
if (na_group == nil) then return end
local group = na_group[id]

require("rikky_module")

--local _, isgroup = rikky_module.getinfo("group")
--if (not isgroup) then return end
if (group == nil) then return end
	
	local x = obj.ox - obj.cx + obj.getvalue("x")
	local y = obj.oy - obj.cy + obj.getvalue("y")
	local z = obj.oz - obj.cz + obj.getvalue("z")
	local rx = obj.rx + obj.getvalue("rx")
	local ry = obj.ry + obj.getvalue("ry")
	local rz = (obj.rz + obj.getvalue("rz")) / 2
	local zoom = obj.zoom * (obj.getvalue("zoom")/100)
	local alpha = obj.alpha * obj.getvalue("alpha")
	local aspect = obj.aspect * obj.getvalue("aspect")
	
	
	local z_x = 100
	local z_y = 100
	if (aspect > 0) then
		z_x = (1-aspect)*100
		obj.effect("リサイズ", "X", z_x, "Y", z_y)
	else
		z_y = (1+aspect)*100
		obj.effect("リサイズ", "X", z_x, "Y", z_y)
	end
	
	local gobj = {x = x, y = y, z = z, rx = rx, ry = ry, rz = rz, zoom = zoom, alpha = alpha, aspect = aspect, w = obj.w, h = obj.h}
	gobj.image = #group.objs
	rikky_module.image("w", "na_groupobj_" .. id .. "_" .. gobj.image)
	
	table.insert(group.objs, gobj)

obj.alpha = 0
obj.zoom = 0

@[Utility] InitializeGroup
--track0:ID,0,1000,0,1

if (na_group == nil) then na_group = {} end

local id = tostring(obj.track0)
local group = {}

na_group[id] = group
group.min_x = 0
group.min_y = 0
group.max_x = 0
group.max_y = 0
group.objs = {}
group.setup = false

@[Utility] StoreImage
--track0:ID,1,1000,1,1
--dialog:[Image]EachObject/chk,imgeach=0;

require("rikky_module")

local id = obj.track0 .. "_" .. (obj.index * imgeach)
rikky_module.image("w", "na_store_" .. id)

@[Utility] LoadImage
--track0:ID,1,1000,1,1
--dialog:[Image]EachObject/chk,imgeach=0;

require("rikky_module")

local id = obj.track0 .. "_" .. (obj.index * imgeach)
rikky_module.image("r+", "na_store_" .. id)

@[Utility] RotateAndBuffering
--track0:Angle,-9999,9999,0,0.1
--check0:RotateBack

require("rikky_module")
local ox,oy,oz,rx,ry,orz,zoom,alpha,aspect,cx,cy,cz = obj.ox,obj.oy,obj.oz,obj.rx,obj.ry,obj.rz,obj.zoom,obj.alpha,obj.aspect,obj.cx,obj.cy,obj.cz

	local rz = obj.track0
	local length = math.sqrt(math.pow(obj.w / 2, 2) + math.pow(obj.h / 2, 2))
	local baseangle = math.atan2(obj.h/2, obj.w/2) --math.asin((h / 2) / length)
	local baseangle_anti = (math.pi - baseangle)
	
	local p1x = math.cos(math.rad(-rz) + baseangle) * length
	local p1y = math.sin(math.rad(-rz) + baseangle) * length
	local p2x = math.cos(math.rad(-rz) - baseangle) * length
	local p2y = math.sin(math.rad(-rz) - baseangle) * length
	local p3x = math.cos(math.rad(-rz) + baseangle_anti) * length
	local p3y = math.sin(math.rad(-rz) + baseangle_anti) * length
	local p4x = math.cos(math.rad(-rz) - baseangle_anti) * length
	local p4y = math.sin(math.rad(-rz) - baseangle_anti) * length
	
	local maxx = math.max(p1x, p2x, p3x, p4x)
	local minx = math.min(p1x, p2x, p3x, p4x)
	local maxy = math.max(p1y, p2y, p3y, p4y)
	local miny = math.min(p1y, p2y, p3y, p4y)
	
obj.setoption("drawtarget", "tempbuffer", math.abs(maxx - minx), math.abs(maxy - miny))

obj.draw(0, 0, 0, 1, 1, 0, 0, obj.track0)

obj.setoption("drawtarget", "framebuffer")

obj.load("tempbuffer")

obj.ox,obj.oy,obj.oz,obj.rx,obj.ry,obj.rz,obj.zoom,obj.alpha,obj.aspect,obj.cx,obj.cy,obj.cz = ox,oy,oz,rx,ry,orz,zoom,alpha,aspect,cx,cy,cz

if (obj.check0) then
obj.rz = -obj.track0
end

@[Utility] Clipping%
--track0:上,0,100,0,0.01
--track1:下,0,100,0,0.01
--track2:左,0,100,0,0.01
--track3:右,0,100,0,0.01

local top,left,right,bottom = (obj.track0 / 100),(obj.track2 / 100),(obj.track3 / 100),(obj.track1 / 100)

local zoom = obj.zoom * obj.getvalue("zoom") / 100

obj.effect("クリッピング", "上", top * obj.h / zoom, "下", bottom * obj.h / zoom, "左", left * obj.w / zoom, "右", right * obj.w / zoom)

@[Utility] AbsoluteClipping
--track0:X,-9999,9999,0,0.1
--track1:Y,-9999,9999,0,0.1
--track2:Width,0,9999,100,0.1
--track3:Height,0,9999,100,0.1
--check0:Center

local top = (obj.h/2) - (obj.track3/2) + obj.track1
local bottom = (obj.h/2) - (obj.track3/2) - obj.track1
local left = (obj.w/2) - (obj.track2/2) + obj.track0
local right = (obj.w/2) - (obj.track2/2) - obj.track0

local zoom = obj.zoom * obj.getvalue("zoom") / 100
local check0 = 0
if (obj.check0) then
	check0 = 1
end

obj.effect("クリッピング", "上", top / zoom, "下", bottom / zoom, "左", left / zoom, "右", right / zoom, "中心の位置を変更", check0)

@[Utility] Place
--track0:X,-9999,9999,0,0.1
--track1:Y,-9999,9999,0,0.1
--track2:Z,-9999,9999,0,0.1
--track3:Zoom,0,9999,100,0.01
--dialog:Count,count=4;Alpha,alpha=1;ResetPosition/chk,resetpos=0;

if (resetpos == 1) then
	obj.ox = 0
	obj.oy = 0
	obj.oz = 0
	obj.zoom = 1
end

local rate = obj.index / (obj.num-1)

obj.ox = obj.ox + (rate * obj.track0)
obj.oy = obj.oy + (rate * obj.track1)
obj.oz = obj.oz + (rate * obj.track2)
obj.zoom = obj.zoom + (((obj.track3/100) - obj.zoom) * rate)
obj.alpha = obj.alpha + ((alpha - obj.alpha) * rate)

@[Utility] Align/Origin
--track0:alignX,0,100,50,0.1
--track1:alignY,0,100,50,0.1
--track2:originX,0,100,50,0.1
--track3:originY,0,100,50,0.1
--check0:ChangeCenter

obj.ox = obj.ox + ((0.5-(obj.track0 / 100)) * obj.screen_w)
obj.oy = obj.oy + ((0.5-(obj.track1 / 100)) * obj.screen_h)

if (obj.check0) then
	obj.cx = obj.cx + ((0.5-(obj.track2 / 100)) * obj.w)
	obj.cy = obj.cy + ((0.5-(obj.track3 / 100)) * obj.h)
else
	obj.ox = obj.ox + ((0.5-(obj.track2 / 100)) * obj.w)
	obj.oy = obj.oy + ((0.5-(obj.track3 / 100)) * obj.h)
end

@[Utility] Audio_Timing_Video
--track0:AudioTime,-100,9999,0,0.1
--track1:VideoTime,1,99999,1,1
--track2:AutoHide,0,9999,0,1
--file:

if (na_currentotogedata == nil) then
	return
end

if (varutl == nil) then
	varutl = {}
end

local tim = obj.time + obj.track0
local otogedata = na_currentotogedata
local thevalue = obj.track1
local prevnote = nil
for k,v in pairs(otogedata.notes) do
	if (v.timing <= tim) then
		thevalue = (math.max(tim - v.timing, 0) * obj.framerate)
	end
end

if ((obj.track2 > 0) and (thevalue >= obj.track2)) then
	return
end

obj.load("movie", file, (obj.track1 + thevalue)/obj.framerate)

@[Utility] Audio_Timing_Flip
--track0:AudioTime,-100,9999,0,0.1
--check0:Flipped

if (na_currentotogedata == nil) then
	return
end

if (varutl == nil) then
	varutl = {}
end

local tim = obj.time + obj.track0
local otogedata = na_currentotogedata
local thevalue = obj.check0
for k,v in pairs(otogedata.notes) do
	if (v.timing <= tim) then
		thevalue = not thevalue
	end
end

if (thevalue) then
	obj.effect("反転", "左右反転", 1)
end

@[Utility] LuaLoad
--file:

dofile(file)